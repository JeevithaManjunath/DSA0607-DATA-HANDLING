# Create the dataset
months <- c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")

sales <- c(12000, 15000, 18000, 17000, 20000, 22000,
           21000, 23000, 25000, 24000, 26000, 28000)

# Plot the line chart
plot(sales,
     type = "o",
     col = "blue",
     lwd = 2,
     pch = 16,
     xaxt = "n",
     xlab = "Month",
     ylab = "Sales",
     main = "Monthly Sales Trend")

axis(1, at = 1:12, labels = months)
grid()
# Top Selling Products Data

products <- c("Product A", "Product B", "Product C", "Product D", "Product E")
sales <- c(45000, 38000, 52000, 41000, 47000)

# Bar Chart with different colors
barplot(sales,
        names.arg = products,
        col = rainbow(5),
        border = "black",
        xlab = "Products",
        ylab = "Sales",
        main = "Top-Selling Products for the Year")
# Advertising Budget and Monthly Sales Data

advertising <- c(3000, 3500, 4000, 3800, 4500)
sales <- c(15000, 18000, 22000, 20000, 23000)

# Create Scatter Plot
plot(advertising, sales,
     pch = 19,
     col = "blue",
     xlab = "Advertising Budget",
     ylab = "Monthly Sales",
     main = "Relationship Between Advertising Budget and Monthly Sales")

# Add Regression Line
abline(lm(sales ~ advertising), col = "red", lwd = 2)

# Add Grid
grid()
# Install packages (Run only once)
install.packages("plotly")
library(plotly)

# Monthly Sales Data
month <- c("January", "February", "March", "April", "May")
sales <- c(15000, 18000, 22000, 20000, 23000)

# Interactive Line Chart
line_chart <- plot_ly(
  x = month,
  y = sales,
  type = "scatter",
  mode = "lines+markers",
  name = "Sales Trend"
)

# Interactive Bar Chart
bar_chart <- plot_ly(
  x = month,
  y = sales,
  type = "bar",
  name = "Monthly Sales"
)

# Display Dashboard
subplot(line_chart, bar_chart, nrows = 2, titleY = TRUE) %>%
  layout(
    title = "Interactive Monthly Sales Dashboard",
    xaxis = list(title = "Month"),
    yaxis = list(title = "Sales ($)"),
    xaxis2 = list(title = "Month"),
    yaxis2 = list(title = "Sales ($)")
  )
# Install plotly (Run only once)
install.packages("plotly")

# Load library
library(plotly)

# Monthly Sales Data
month <- c("January", "February", "March", "April", "May")
sales <- c(15000, 18000, 22000, 20000, 23000)

# Create Interactive Dashboard
subplot(
  
  plot_ly(
    x = month,
    y = sales,
    type = "scatter",
    mode = "lines+markers"
  ) %>%
    layout(
      title = "Monthly Sales Trend",
      xaxis = list(title = "Month"),
      yaxis = list(title = "Sales ($)")
    ),
  
  plot_ly(
    x = month,
    y = sales,
    type = "bar"
  ) %>%
    layout(
      title = "Monthly Sales Bar Chart",
      xaxis = list(title = "Month"),
      yaxis = list(title = "Sales ($)")
    ),
  
  nrows = 2,
  titleY = TRUE
  
) %>%
  layout(title = "Interactive Monthly Sales Dashboard")
